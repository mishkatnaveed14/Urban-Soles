<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop Sneakers | Urban Soles</title>
  <link rel="stylesheet" href="/build/assets/main.css">
</head>
<body>
  <%- include('../partial/navbar') %>
  <main class="shop-page">
    <header class="shop-heading">
      <span class="shop-kicker">FIND YOUR NEXT FAVORITE</span>
      <h1 class="shop-title">The sneaker edit</h1>
      <p class="shop-description">Easy comfort. Everyday confidence. Find your pair.</p>
    </header>

    <form class="shop-filters" action="/shop" method="GET">
      <input type="search" name="search" value="<%= search %>" placeholder="Search shoes, styles, categories..." aria-label="Search products">
      <select name="category" aria-label="Filter by category">
        <option value="">All categories</option>
        <% ['Men', 'Women', 'Kids'].forEach(function (option) { %>
          <option value="<%= option %>" <%= category.toLowerCase() === option.toLowerCase() ? 'selected' : '' %>><%= option %></option>
        <% }) %>
      </select>
      <select name="sort" aria-label="Sort products">
        <option value="">Recommended</option>
        <option value="new" <%= sort === 'new' ? 'selected' : '' %>>New arrivals</option>
        <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Most popular</option>
        <option value="price-low" <%= sort === 'price-low' ? 'selected' : '' %>>Price: low to high</option>
        <option value="price-high" <%= sort === 'price-high' ? 'selected' : '' %>>Price: high to low</option>
      </select>
      <select name="max" aria-label="Filter by maximum price">
        <option value="">Any price</option>
        <option value="8000" <%= Number(max) === 8000 ? 'selected' : '' %>>Under Rs. 8,000</option>
        <option value="12000" <%= Number(max) === 12000 ? 'selected' : '' %>>Under Rs. 12,000</option>
        <option value="16000" <%= Number(max) === 16000 ? 'selected' : '' %>>Under Rs. 16,000</option>
      </select>
      <label class="sale-filter">
        <input type="checkbox" name="sale" value="true" <%= sale ? 'checked' : '' %>>
        On sale
      </label>
      <% if (type) { %><input type="hidden" name="type" value="<%= type %>"><% } %>
      <button class="filter-submit" type="submit">Apply filters</button>
    </form>

    <p class="results-count"><%= products.length %> <%= products.length === 1 ? 'pair' : 'pairs' %> found</p>

    <% if (products.length) { %>
      <section class="product-grid" aria-label="Sneaker results">
        <% products.forEach(function (product) { %>
          <article class="product-card">
            <div class="product-visual">
              <span class="product-tag"><%= product.tag %></span>
              <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy">
            </div>
            <div class="product-info">
              <span class="product-category"><%= product.category %> / <%= product.type %></span>
              <h2 class="product-name"><%= product.name %></h2>
              <p class="product-price"><%= new Intl.NumberFormat('en-PK', { style: 'currency', currency: 'PKR', maximumFractionDigits: 0 }).format(product.price) %>
                <% if (product.oldPrice) { %><del><%= new Intl.NumberFormat('en-PK', { style: 'currency', currency: 'PKR', maximumFractionDigits: 0 }).format(product.oldPrice) %></del><% } %>
              </p>
              <a class="product-link" href="/product-detail?product=<%= product.id %>">View details &rarr;</a>
              <form class="product-buy-controls" data-product-form>
                <label class="sr-only" for="shop-size-<%= product.id %>">Choose UK size for <%= product.name %></label>
                <select id="shop-size-<%= product.id %>" name="size" required>
                  <option value="">Select size</option>
                  <% product.sizes.forEach(function (size) { %>
                    <option value="<%= size %>">UK <%= size %></option>
                  <% }) %>
                </select>
                <button class="store-button store-button-primary" type="button" data-product-add data-product-id="<%= product.id %>">Add to cart</button>
                <span class="product-add-notice" data-product-notice role="status" aria-live="polite"></span>
              </form>
            </div>
          </article>
        <% }) %>
      </section>
    <% } else { %>
      <div class="empty-results">
        <h2>No sneakers match those filters</h2>
        <p>Try a different search or clear some filters.</p>
        <a class="product-link" href="/shop">Clear filters &rarr;</a>
      </div>
    <% } %>
  </main>
</body>
</html>