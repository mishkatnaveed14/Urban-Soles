<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout | Urban Soles</title>
  <link rel="stylesheet" href="/build/assets/main.css">
</head>
<body>
  <%- include('../partial/navbar') %>
  <main class="store-page checkout-page">
    <a class="store-back-link" href="/cart">&larr; Back to your cart</a>
    <header class="store-page-heading">
      <span class="store-eyebrow">ALMOST YOURS</span>
      <h1>Delivery details</h1>
      <p>Review your pair and enter your delivery information.</p>
    </header>

    <div class="checkout-layout">
      <form id="checkout-form" class="checkout-form">
        <h2>Shipping information</h2>
        <div class="checkout-fields">
          <label>
            Full name
            <input name="name" autocomplete="name" required>
          </label>
          <label>
            Email address
            <input type="email" name="email" autocomplete="email" required>
          </label>
          <label>
            Phone number
            <input type="tel" name="phone" autocomplete="tel" required>
          </label>
          <label>
            City
            <input name="city" autocomplete="address-level2" required>
          </label>
          <label class="checkout-address">
            Delivery address
            <textarea name="address" autocomplete="street-address" rows="3" required></textarea>
          </label>
        </div>
        <p class="checkout-payment-note">Payment and order submission are not connected in this demo.</p>
        <button class="store-button store-button-primary store-button-wide" type="submit" data-checkout-submit>Review order</button>
        <p id="checkout-status" class="checkout-status" role="status" aria-live="polite"></p>
      </form>

      <aside class="store-summary checkout-summary">
        <h2>Your order</h2>
        <div id="checkout-items" aria-live="polite"></div>
        <div class="summary-row">
          <span>Subtotal</span>
          <strong id="checkout-subtotal">Rs. 0</strong>
        </div>
        <div class="summary-row">
          <span>Shipping</span>
          <strong>Free</strong>
        </div>
        <div class="summary-row summary-total">
          <span>Total</span>
          <strong id="checkout-total">Rs. 0</strong>
        </div>
      </aside>
    </div>
  </main>
</body>
</html>