<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product ? product.name + ' | Urban Soles' : 'Product not found | Urban Soles' %></title>
  <link rel="stylesheet" href="/build/assets/main.css">
</head>
<body>
  <%- include('../partial/navbar') %>
  <main class="store-page">
    <% if (product) { %>
      <a class="store-back-link" href="/shop">&larr; Back to the collection</a>
      <section class="product-detail-layout">
        <div class="product-detail-image">
          <img src="<%= product.image %>" alt="<%= product.name %>">
        </div>
        <div class="product-detail-information">
          <span class="store-eyebrow"><%= product.tag %> / <%= product.category %></span>
          <h1><%= product.name %></h1>
          <p class="product-detail-type"><%= product.type %> / <%= product.color %></p>
          <p class="product-detail-description"><%= product.description %></p>
          <p class="product-detail-price">
            <strong><%= new Intl.NumberFormat('en-PK', { style: 'currency', currency: 'PKR', maximumFractionDigits: 0 }).format(product.price) %></strong>
            <% if (product.oldPrice) { %>
              <del><%= new Intl.NumberFormat('en-PK', { style: 'currency', currency: 'PKR', maximumFractionDigits: 0 }).format(product.oldPrice) %></del>
            <% } %>
          </p>
          <form class="product-detail-buy" data-product-form>
            <label for="product-size">Select UK size</label>
            <select id="product-size" name="size" required>
              <option value="">Choose your size</option>
              <% product.sizes.forEach(function (size) { %>
                <option value="<%= size %>">UK <%= size %></option>
              <% }) %>
            </select>
            <button type="button" class="store-button store-button-primary store-button-wide" data-product-add data-product-id="<%= product.id %>">Add to cart</button>
            <p class="product-add-notice" data-product-notice role="status" aria-live="polite"></p>
          </form>
          <p class="product-detail-shipping">Free shipping. Easy everyday comfort.</p>
        </div>
      </section>
    <% } else { %>
      <section class="store-empty-page">
        <span class="store-eyebrow">THAT PAIR ISN'T HERE</span>
        <h1>Product not found</h1>
        <p>It may have moved or the product link may be incorrect.</p>
        <a class="store-button store-button-primary" href="/shop">Explore the collection</a>
      </section>
    <% } %>
  </main>
</body>
</html>