<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Cart | Urban Soles</title>
  <link rel="stylesheet" href="/build/assets/main.css">
</head>
<body>
  <%- include('../partial/navbar') %>
  <main class="store-page cart-page">
    <a class="store-back-link" href="/shop">&larr; Continue shopping</a>
    <header class="store-page-heading">
      <span class="store-eyebrow">YOUR PICKS, READY TO GO</span>
      <h1>Your shopping cart</h1>
      <p><span data-cart-page-count>0</span> <span data-cart-page-count-label>items</span> in your cart</p>
    </header>

    <div class="cart-page-layout">
      <section id="cart-page-items" aria-label="Items in your shopping cart" aria-live="polite"></section>

      <aside class="store-summary">
        <h2>Order summary</h2>
        <div class="summary-row">
          <span>Subtotal</span>
          <strong id="cart-page-subtotal">Rs. 0</strong>
        </div>
        <div class="summary-row">
          <span>Shipping</span>
          <strong>Free</strong>
        </div>
        <div class="summary-row summary-total">
          <span>Total</span>
          <strong id="cart-page-total">Rs. 0</strong>
        </div>
        <a class="store-button store-button-primary store-button-wide" href="/checkout" data-cart-checkout>Continue to checkout</a>
        <p class="summary-note">Shipping is free on every order.</p>
      </aside>
    </div>
  </main>
</body>
</html>